<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 店名 -->
        <TextView
            android:id="@+id/textStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- カテゴリ -->
        <TextView
            android:id="@+id/textStoreCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <!-- 写真 -->
        <ImageView
            android:id="@+id/imageStorePhoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_marginBottom="16dp"/>

        <!-- 住所 -->
        <TextView
            android:id="@+id/textStoreAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <!-- 営業時間 -->
        <TextView
            android:id="@+id/textStoreOpenHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <!-- メニュー -->
        <TextView
            android:id="@+id/textStoreMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <!-- 地図ボタン -->
        <Button
            android:id="@+id/buttonOpenMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_open_map" />

    </LinearLayout>
</ScrollView>
